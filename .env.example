# App
APP_NAME=Devinder AI Agent Studio
VITE_APP_NAME=Devinder AI Agent Studio

# Database
# Local SQLite fallback
DATABASE_URL=sqlite:///./data/ai_agent_studio.db

# Production Postgres example
# DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# Note: For EasyPanel or Docker deployments, both backend service and telegram worker service must use the exact same DATABASE_URL.

# LLM
LLM_PROVIDER=openai
USE_MOCK_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backend / Frontend URLs
BACKEND_URL=https://your-backend-domain.com
VITE_API_BASE_URL=https://your-backend-domain.com/api
VITE_WS_BASE_URL=wss://your-backend-domain.com

# Background Workers
TELEGRAM_ENABLED=false
SCHEDULER_ENABLED=false

# Telegram
TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_WORKFLOW_ID=

# Security / CORS
API_AUTH_ENABLED=false
API_KEY=
# Use "*" only for demo/testing. For production, use exact frontend domain:
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_ENABLED=false
