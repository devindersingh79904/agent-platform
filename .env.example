# LLM settings
# For deterministic local demo/tests:
USE_MOCK_LLM=true

# For real OpenAI demo:
# USE_MOCK_LLM=false
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MODEL=gemini-1.5-pro
MOCK_LLM_DELAY_MS=800

# Telegram settings
# Create token from Telegram @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
DEFAULT_TELEGRAM_WORKFLOW_ID=

# Database
DATABASE_URL=sqlite:///./data/ai_agent_studio.db

# Backend / frontend URLs
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000

# Search tools
# DuckDuckGo search does not require an API key.
SEARCH_PROVIDER=duckduckgo
DUCKDUCKGO_MAX_RESULTS=5

# Application Branding and CORS Setup
APP_NAME=Devinder AI Agent Studio
VITE_APP_NAME=Devinder AI Agent Studio
CORS_ALLOWED_ORIGINS=http://localhost:3000

