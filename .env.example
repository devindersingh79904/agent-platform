# App
APP_NAME=Devinder AI Agent Studio
VITE_APP_NAME=Devinder AI Agent Studio

# Database - SQLite demo deployment
DATABASE_URL=sqlite:///./data/agent_studio.db

# LLM
LLM_PROVIDER=openai
USE_MOCK_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backend / Frontend URLs
BACKEND_URL=https://your-backend-domain.com
VITE_API_BASE_URL=https://your-backend-domain.com/api
VITE_WS_BASE_URL=wss://your-backend-domain.com

# Telegram
TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_WORKFLOW_ID=

# Security / CORS
API_AUTH_ENABLED=false
API_KEY=
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
RATE_LIMIT_ENABLED=false
