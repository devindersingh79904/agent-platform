# LLM settings
# For deterministic local demo/tests:
USE_MOCK_LLM=true

# For real OpenAI demo:
# USE_MOCK_LLM=false
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_LLM_DELAY_MS=800

# Telegram settings
# Create token from Telegram @BotFather.
TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_WORKFLOW_ID=

# Database
DATABASE_URL=sqlite:///./data/yuno_agent_studio.db

# Backend / frontend URLs
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000

# Search tools
# DuckDuckGo search does not require an API key.
SEARCH_PROVIDER=duckduckgo
DUCKDUCKGO_MAX_RESULTS=5
